<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote  name="mediumsos"
           fetch="https://github.com/MediumsOS"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/lineage-23.0" />

  <!-- Build -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="mediumsos" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <!-- Build -->
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="mediumsos" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Bootable Recovery -->
  <project path="bootable/recovery" name="bootable_recovery" remote="mediumsos" />

  <!-- Packages -->
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="mediumsos" />

  <!-- Vendor -->
  <project path="vendor/lineage" name="vendor_mediums" remote="mediumsos" />

</manifest>
